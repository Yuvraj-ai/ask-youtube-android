<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Cleartext stays off app-wide. Every endpoint this app uses is HTTPS:
         generativelanguage.googleapis.com and youtube.com. -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
